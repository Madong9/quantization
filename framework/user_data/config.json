{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "binance-eth-ema-futures",
  "initial_state": "running",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "cancel_open_orders_on_exit": true,
  "timeframe": "1m",
  "strategy": "EmaCrossFuturesStrategy",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.2,
  "fiat_display_currency": "USD",
  "db_url": "sqlite:///user_data/tradesv3.dryrun.sqlite",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "future",
        "adjustForTimeDifference": true
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "future",
        "adjustForTimeDifference": true
      }
    },
    "pair_whitelist": [
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "internals": {
    "process_throttle_secs": 5
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "replace-with-random-jwt-secret",
    "ws_token": "replace-with-random-ws-token",
    "CORS_origins": [],
    "username": "freqtrader",
    "password": "replace-with-a-strong-password"
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  }
}
